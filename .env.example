# Copy to .env (never commit .env). Placeholders only.
# Adaption Labs (src/forecasting/adaption_adapter.py). Leave unset to keep the integration disabled.
ADAPTION_API_KEY=your-adaption-api-key
# ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai
# Must be an id returned by `python -m src.forecasting.finetune adaption-check`.
ADAPTION_CHRONOS_MODEL_ID=
# Explicit opt-ins: uploading campus data and starting paid training are refused unless set to 1
# AND the command is run with --confirm.
ADAPTION_ALLOW_UPLOAD=0
ADAPTION_ALLOW_PAID_TRAINING=0
# Optional Hugging Face token for faster Chronos-2 weight downloads.
# HF_TOKEN=
# Opt-in live tests (see tests/test_live_integration.py).
# TANACIOUS_LIVE_CHRONOS=1
# TANACIOUS_LIVE_ADAPTION=1
